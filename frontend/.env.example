# Copy this file to .env (Vite loads .env automatically, gitignored by default
# via the frontend/.gitignore this scaffold creates).
#
# backend/app/main.py listens on port 8000 by default (see backend/README.md:
# `python -m uvicorn backend.app.main:app --reload --port 8000`, run from the
# project root). These two must point at the same running backend instance,
# one as an http(s):// URL (for GET /api/... calls) and one as the matching
# ws(s):// URL (for the WS /ws/run live-run connection).
VITE_BACKEND_HTTP_URL=http://localhost:8000
VITE_BACKEND_WS_URL=ws://localhost:8000
