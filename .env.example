# Copy this file to .env and fill in ONE provider's key.
# Never commit .env or put a real key in this file.

# Which provider EvalMind's CrewAI agents (Describer, Generator, Judge) use.
# One of: openai | anthropic | groq | gemini
LLM_PROVIDER=openai

# --- OpenAI (used if LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (used if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Groq (used if LLM_PROVIDER=groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini (used if LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# --- Navigatto AUT (socketio_endpoint mode, scripts/test_navigatto_round.py) ---
# JWT obtained by manually logging into YOUR auth system (not the AUT itself
# -- Navigatto's backend has no login endpoint, only JWT verification).
# Never commit a real value here.
NAVIGATTO_JWT=
NAVIGATTO_WS_URL=https://navigattodev.azurewebsites.net

# Rate limiting for Gemini free tier (uncomment if hitting 429 quota errors)
# CREWAI_MAX_RPM=10
